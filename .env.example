# Optional. The app runs without this file.
# Copy to .env only if you want hosted Supabase or Groq.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional. Persist conversations, orders, and admin analytics.
# Without it, the concierge still runs (session store on the client).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional. Without it, intent detection falls back to keywords.
GROQ_API_KEY=
GROQ_MODEL=

# Optional. Defaults to the Vercel URL in production.
SITE_URL=
